{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "controllers/**/*.ts", "db/**/*.ts", "middleware/**/*.ts", "models/**/*.ts", "routes/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", "**/*.d.ts"]
}
