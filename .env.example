NODE_ENV=production
PORT=8000
DB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
DB_NAME=data
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated browser origins. Leave empty to allow public non-credentialed CORS.
CORS_ORIGINS=https://theafricanplaces.com,https://www.theafricanplaces.com
# Number of trusted reverse-proxy hops. Configure this for your hosting provider.
TRUST_PROXY=1
SENTRY_DSN=
# Optional cache. API works normally without either value.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
